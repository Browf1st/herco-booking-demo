# Complete configuration inventory. Blank values need setup for their feature.
# This file contains examples only. Real secrets belong in ignored local files
# or the corresponding deployment/runner secret store.
# Use an isolated Supabase project for staging.
#
# SITE: .env.local for SvelteKit; .dev.vars for local Wrangler.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
HERCO_AUTH_EMAIL_ENABLED=false
HERCO_AUTH_GOOGLE_ENABLED=false
HERCO_AUTH_FACEBOOK_ENABLED=false
HERCO_STORAGE_SECRET_KEY=
HERCO_GA4_MEASUREMENT_ID=
HERCO_GA4_API_SECRET=

# EMAIL WORKER: configure separately using wrangler.email.jsonc.
# Its database credential is used by the server worker.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
STAGING_EMAIL_ALLOWLIST=
HERCO_EMAIL_MODE=disabled
HERCO_REMINDER_LEAD_HOURS=0

# PHOTO CLEANUP WORKER: configure separately using wrangler.cleanup.jsonc.
HERCO_PHOTO_CLEANUP_URL=
HERCO_PHOTO_CLEANUP_SECRET_KEY=
HERCO_PHOTO_CLEANUP_MODE=disabled
HERCO_PHOTO_CLEANUP_RETENTION_DAYS=0

# DATABASE MIGRATIONS AND BACKUP RUNNER: private machine/runner environment.
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
PGSSLMODE=verify-full
# Optional CA certificate path and connection timeout.
PGSSLROOTCERT=
PGCONNECT_TIMEOUT=15

# BACKUP RUNNER: load explicitly into the runner environment.
# Direct node script execution does not automatically read this example file.
HERCO_BACKUP_MODE=disabled
HERCO_BACKUP_DIRECTORY=
HERCO_BACKUP_AGE_RECIPIENT=
HERCO_BACKUP_ALERT_WEBHOOK=
HERCO_MEDIA_SOURCE_SUPABASE_URL=
HERCO_MEDIA_SOURCE_SECRET_KEY=
HERCO_MEDIA_ENCRYPTION_KEY=

# ISOLATED RESTORE DRILL: populate only for the intended recovery environment.
HERCO_MEDIA_TARGET_SUPABASE_URL=
HERCO_MEDIA_TARGET_SECRET_KEY=
HERCO_MEDIA_RESTORE_ACCEPT=

# PROVIDER DASHBOARD SETTINGS: these have no application environment variable.
# Supabase Auth: Brevo SMTP host, port, login, SMTP key, sender and email templates.
# Supabase Auth: Google/Facebook app credentials and callback allowlists.
# Supabase Storage: private herco-completion bucket and media/size restrictions.
# Database: approved walk-in form, staff grants and change_request_inbox.
# Cloudflare: staging hostname and each Worker's secret bindings.
# Backup scheduler: frequency, retention, destination and recovery-key access.
