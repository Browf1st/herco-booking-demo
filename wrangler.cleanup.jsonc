{
	"name": "herco-staging-photo-cleanup",
	"main": "src/workers/photo-cleanup.ts",
	"compatibility_date": "2026-11-19",
	"workers_dev": false,
	"preview_urls": false,
	"triggers": {
		"crons": ["15 * * * *"]
	},
	"vars": {
		"HERCO_PHOTO_CLEANUP_MODE": "disabled",
		"HERCO_PHOTO_CLEANUP_RETENTION_DAYS": "0"
	}
}
